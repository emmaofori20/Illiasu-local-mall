@model CategoryForm
<div class="space-y-6"><div><label asp-for="Name" class="category-label">Category name</label><input asp-for="Name" class="category-input" maxlength="100" required autocomplete="off" aria-describedby="name-error" /><span asp-validation-for="Name" id="name-error" class="mt-2 block text-sm text-error"></span></div>
<div><div class="flex items-center justify-between gap-3"><label asp-for="Slug" class="category-label">URL slug</label><button type="button" class="min-h-11 text-sm font-medium text-link underline" data-edit-slug hidden>Edit slug</button></div><input asp-for="Slug" class="category-input" maxlength="160" required pattern="[a-z0-9]+(-[a-z0-9]+)*" autocomplete="off" spellcheck="false" aria-describedby="slug-help slug-error" /><p id="slug-help" class="mt-2 text-sm text-text-muted">Generated from the name for new categories. Existing slugs stay unchanged. Use Edit slug to customize. Slugs must be unique, even for inactive categories.</p><span asp-validation-for="Slug" id="slug-error" class="mt-2 block text-sm text-error"></span></div></div>
