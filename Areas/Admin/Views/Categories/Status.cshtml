@model CategoryStatusForm
@{ var deactivate = Model.Category.IsActive; ViewData["Title"] = deactivate ? "Deactivate category" : "Activate category"; }
<div class="admin-page-heading"><div><p class="eyebrow">Catalogue visibility</p><h1>@ViewData["Title"]</h1><p>Review the impact before changing this category.</p></div><a class="button button-secondary" asp-action="Index">Back to categories</a></div>
<section class="admin-panel max-w-3xl p-8 phone:p-5"><h2 class="break-words text-xl font-semibold tracking-tight">@Model.Category.Name</h2><p class="mt-2 break-words text-sm text-text-muted">@Model.Category.Slug · @Model.Category.Products linked products</p>
<div class="mt-6 rounded-xl bg-info-surface p-5 text-sm leading-6 text-info"><h3 class="font-semibold">Storefront visibility impact</h3><p class="mt-2">@(deactivate ? "Future storefront browsing, search and ordering will exclude this category and its linked products while inactive." : "Future storefront browsing can include this category. Individual product and variant availability still applies.")</p><p class="mt-3">Product links and availability flags stay unchanged. Historical references are preserved. The current demonstration storefront is unchanged.</p></div>
<form asp-action="Status" asp-route-id="@Model.Category.Id" method="post" class="mt-6" data-submit-state><input asp-for="Snapshot" type="hidden" /><div asp-validation-summary="All" class="category-errors" role="alert"></div><label class="flex min-h-11 cursor-pointer items-start gap-3 text-sm leading-6"><input asp-for="Confirm" class="mt-1 h-5 w-5 shrink-0 accent-brand" aria-describedby="confirm-error" required />I understand the visibility impact and want to @(deactivate ? "deactivate" : "activate") this category.</label><span asp-validation-for="Confirm" id="confirm-error" class="mt-2 block text-sm text-error"></span><div class="mt-6 flex flex-wrap gap-3"><button class="button button-primary" type="submit" data-busy-label="Updating...">Confirm @(deactivate ? "deactivation" : "activation")</button><a class="button button-secondary" asp-action="Index">Cancel</a><span role="status" class="text-sm text-text-muted" data-form-status></span></div></form></section>
