@model ConversionCreateInput
@{ var units=(IReadOnlyList<ILLiasu_Local_Mall.Domain.Entities.UnitOfMeasure>)ViewData["CreateUnits"]!; var rowId=ViewData.TemplateInfo.HtmlFieldPrefix.Replace("[","_").Replace("]","_").Replace(".","_"); }
<fieldset data-conversion class="rounded-xl bg-surface-subtle p-4"><legend class="sr-only">Receiving unit for this selling option</legend><div class="grid grid-cols-2 gap-4 phone:grid-cols-1"><div><label asp-for="FromUnitOfMeasureId" class="category-label">Received / counted as</label><select asp-for="FromUnitOfMeasureId" class="category-input" required aria-describedby="@(rowId)_source_error"><option value="">Choose an alternate unit</option>@foreach(var u in units) { <option value="@u.Id">@u.Name (@u.Symbol)</option> }</select><span asp-validation-for="FromUnitOfMeasureId" id="@(rowId)_source_error" class="create-error"></span></div><div><label asp-for="Factor" class="category-label">Selling units per received unit</label><input asp-for="Factor" class="category-input" type="number" min="0.000001" step="0.000001" required aria-describedby="@(rowId)_factor_error" /><span asp-validation-for="Factor" id="@(rowId)_factor_error" class="create-error"></span></div></div><div class="mt-3 flex flex-wrap items-center justify-between gap-3"><label class="flex min-h-11 items-center gap-2 text-sm"><input asp-for="IsActive" class="h-5 w-5 accent-brand" />Receiving unit active</label><button type="button" data-remove-conversion class="min-h-11 text-sm text-error underline" hidden>Remove receiving unit</button></div></fieldset>

