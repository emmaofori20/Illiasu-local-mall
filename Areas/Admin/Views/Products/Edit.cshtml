@model ProductEditForm
@{ ViewData["Title"]="Edit product"; }
<div class="admin-page-heading"><div><p class="eyebrow">Catalogue management</p><h1>Edit product</h1><p>Update product details and prices while preserving existing stock rules.</p></div><a class="button button-secondary" asp-action="Index">Back to products</a></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" data-edit-product id="product-create-form" data-submit-state>
@{ ViewContext.FormContext.CanRenderAtEndOfForm = false; }
<input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" />
<div asp-validation-summary="All" class="category-errors" role="alert" tabindex="-1"></div>
<div class="grid grid-cols-[minmax(0,2fr)_minmax(240px,1fr)] gap-6 tablet:grid-cols-1">
<div class="min-w-0 space-y-6">
<section class="admin-panel p-6 phone:p-5"><h2 class="text-lg font-semibold">Basic information</h2><div class="mt-6 space-y-5">
<div><label asp-for="Name" class="category-label">Product name</label><input asp-for="Name" class="category-input" maxlength="160" required aria-describedby="product-name-error" /><span asp-validation-for="Name" id="product-name-error" class="create-error"></span></div>
<div><span class="category-label">URL slug (read-only)</span><p class="text-sm text-text-muted break-words">@Model.Slug</p><input asp-for="Slug" type="hidden" /><p class="mt-2 text-sm text-text-muted">Renaming a product does not change its existing URL.</p></div>
<div><label asp-for="CategoryId" class="category-label">Category</label><select asp-for="CategoryId" class="category-input" required aria-describedby="category-error"><option value="">Choose an active category</option>@foreach(var c in Model.Categories) { <option value="@c.Id">@c.Name@(c.IsActive ? "" : " (inactive - current category)")</option> }</select><span asp-validation-for="CategoryId" id="category-error" class="create-error"></span></div>
<div><label asp-for="Description" class="category-label">Description <span class="font-normal text-text-muted">(optional)</span></label><textarea asp-for="Description" class="category-input" maxlength="4000" rows="4" aria-describedby="description-error"></textarea><span asp-validation-for="Description" id="description-error" class="create-error"></span></div>
</div></section>
<section class="admin-panel p-6 phone:p-5" aria-labelledby="existing-title"><h2 id="existing-title" class="text-lg font-semibold">Existing selling options</h2><p class="mt-3 text-sm leading-6 text-text-muted">Change prices, barcodes and availability. Product codes, units and stock rules are preserved. Deactivate an option to stop offering it; historical references remain intact.</p><span asp-validation-for="ExistingVariants" class="create-error"></span>
<div class="mt-6 space-y-5">@for(var i=0;i<Model.ExistingVariants.Count;i++) { var rowData=new ViewDataDictionary(ViewData);rowData.TemplateInfo.HtmlFieldPrefix=$"ExistingVariants[{i}]";Model.Display.TryGetValue(Model.ExistingVariants[i].Id,out var display);rowData["ExistingDisplay"]=display;<partial name="_EditVariant" model="Model.ExistingVariants[i]" view-data="rowData" /> }</div></section>
<section class="admin-panel p-6 phone:p-5" aria-labelledby="selling-title"><div class="flex flex-wrap items-center justify-between gap-3"><h2 id="selling-title" class="text-lg font-semibold">Add new selling options</h2><button type="button" data-add-variant class="button button-secondary" hidden>+ Add selling option</button></div><p class="mt-3 text-sm leading-6 text-text-muted">Optional: add a new single, pack, carton or size. Share stock only with an explicitly selected separately counted source.</p><span asp-validation-for="Variants" class="create-error"></span>
@if(Model.Units.Count==0) { <p role="alert" class="mt-4 rounded-xl bg-warning-surface p-4 text-sm leading-6 text-warning">No active selling units are configured. Ask an administrator to seed or activate unit reference data before creating products. The local setup command is documented in docs/reference-units.md.</p> }
<div data-variant-list class="mt-6 space-y-5">@for(var i=0;i<Model.Variants.Count;i++) { var rowData=new ViewDataDictionary(ViewData);rowData.TemplateInfo.HtmlFieldPrefix=$"Variants[{i}]"; <partial name="_CreateVariant" model="Model.Variants[i]" view-data="rowData" /> }</div>
</section>
<div class="flex flex-wrap gap-3"><button type="submit" class="button button-primary" data-busy-label="Saving changes...">Save changes</button><a asp-action="Index" class="button button-secondary">Cancel</a><span data-form-status role="status" class="text-sm text-text-muted"></span></div>
</div>
<aside class="min-w-0 space-y-6"><section class="admin-panel p-6"><h2 class="text-lg font-semibold">Visibility</h2><label class="mt-5 flex min-h-11 items-start gap-3 text-sm"><input asp-for="IsActive" class="h-5 w-5 accent-brand" />Product active</label><p class="mt-3 text-sm leading-6 text-text-muted">Availability is manual until the inventory engine is implemented. No stock balances or quantities are created here.</p><p class="mt-3 text-sm leading-6 text-text-muted">Future shopping requires an active category, active product and active/available selling option. The demonstration storefront is unchanged.</p></section>
<section class="admin-panel p-6"><h2 class="text-lg font-semibold">Protected catalogue identity</h2><p class="mt-3 text-sm leading-6 text-text-muted">Existing option names, product codes, canonical units, quantity increments, receiving conversions and stock mappings need a reviewed revision workflow. They cannot be changed here.</p><p class="mt-3 text-sm leading-6 text-text-muted">If another user saves while this page is open, your save will be blocked. <a asp-action="Edit" asp-route-id="@Model.Id" class="text-link underline">Reload latest values</a> (discards unsaved entries).</p><h3 class="mt-5 text-sm font-semibold">New stock rules</h3><p class="mt-3 text-sm leading-6 text-text-muted">A carton sold from loose-bottle stock can use the bottle option as its source. Enter the exact bottles per carton; never assume a pack size.</p><p class="mt-3 text-sm leading-6 text-text-muted">Count sealed cartons separately if they must stay sealed. A 25 kg rice bag and a 5 kg rice bag keep their own stock. Nothing is automatically unpacked or merged.</p><p class="mt-3 text-sm leading-6 text-text-muted">Prices are independent of stock quantities. These rules prepare the catalogue for inventory; they do not deduct stock today.</p></section>
@if(Model.Categories.Count==0) { <p role="alert" class="rounded-xl bg-warning-surface p-5 text-sm text-warning">An active category is required. Create or activate one in Category Management.</p> }
</aside></div></form>
<template id="variant-template">@{ var rowData=new ViewDataDictionary(ViewData);rowData.TemplateInfo.HtmlFieldPrefix="Variants[__variant__]"; }<partial name="_CreateVariant" model="@(new VariantCreateInput())" view-data="rowData" /></template>
<template id="conversion-template">@{ var conversionData=new ViewDataDictionary(ViewData);conversionData.TemplateInfo.HtmlFieldPrefix="Variants[__variant__].Conversions[__conversion__]"; }<partial name="_CreateConversion" model="@(new ConversionCreateInput())" view-data="conversionData" /></template>
<script src="~/js/product-create.js" asp-append-version="true" defer></script>

