@model ProductCreateForm
@{ ViewData["Title"]="Add product"; }
<div class="admin-page-heading"><div><p class="eyebrow">Catalogue management</p><h1>Add product</h1><p>Set up selling options, their own prices and clear stock rules.</p></div><a class="button button-secondary" asp-action="Index">Back to products</a></div>
<form asp-action="Create" method="post" enctype="multipart/form-data" id="product-create-form" data-submit-state>
@{ ViewContext.FormContext.CanRenderAtEndOfForm = false; }
<div asp-validation-summary="All" class="category-errors" role="alert" tabindex="-1"></div>
<div class="grid grid-cols-[minmax(0,2fr)_minmax(240px,1fr)] gap-6 tablet:grid-cols-1">
<div class="min-w-0 space-y-6">
<section class="admin-panel p-6 phone:p-5"><h2 class="text-lg font-semibold">Basic information</h2><div class="mt-6 space-y-5">
<div><label asp-for="Name" class="category-label">Product name</label><input asp-for="Name" class="category-input" maxlength="160" required aria-describedby="product-name-error" /><span asp-validation-for="Name" id="product-name-error" class="create-error"></span></div>
<div><div class="flex items-center justify-between"><label asp-for="Slug" class="category-label">URL slug</label><button type="button" data-product-edit-slug class="min-h-11 text-sm text-link underline" hidden>Edit slug</button></div><input asp-for="Slug" class="category-input" required maxlength="180" pattern="[a-z0-9]+(-[a-z0-9]+)*" aria-describedby="product-slug-help product-slug-error" /><p id="product-slug-help" class="mt-2 text-sm text-text-muted">Generated from the name until you choose a custom slug.</p><span asp-validation-for="Slug" id="product-slug-error" class="create-error"></span></div>
<div><label asp-for="CategoryId" class="category-label">Category</label><select asp-for="CategoryId" class="category-input" required aria-describedby="category-error"><option value="">Choose an active category</option>@foreach(var c in Model.Categories) { <option value="@c.Id">@c.Name</option> }</select><span asp-validation-for="CategoryId" id="category-error" class="create-error"></span></div>
<div><label asp-for="Description" class="category-label">Description <span class="font-normal text-text-muted">(optional)</span></label><textarea asp-for="Description" class="category-input" maxlength="4000" rows="4" aria-describedby="description-error"></textarea><span asp-validation-for="Description" id="description-error" class="create-error"></span></div>
</div></section>
<section class="admin-panel p-6 phone:p-5" aria-labelledby="selling-title"><div class="flex flex-wrap items-center justify-between gap-3"><h2 id="selling-title" class="text-lg font-semibold">Selling options</h2><button type="button" data-add-variant class="button button-secondary" hidden>+ Add selling option</button></div><p class="mt-3 text-sm leading-6 text-text-muted">Add singles, packs, cartons or sizes with their own product codes and prices. Stock is separate unless you explicitly choose to share it.</p><span asp-validation-for="Variants" class="create-error"></span>
@if(Model.Units.Count==0) { <p role="alert" class="mt-4 rounded-xl bg-warning-surface p-4 text-sm leading-6 text-warning">No active selling units are configured. Ask an administrator to seed or activate unit reference data before creating products. The local setup command is documented in docs/reference-units.md.</p> }
<div data-variant-list class="mt-6 space-y-5">@for(var i=0;i<Model.Variants.Count;i++) { var rowData=new ViewDataDictionary(ViewData);rowData.TemplateInfo.HtmlFieldPrefix=$"Variants[{i}]"; <partial name="_CreateVariant" model="Model.Variants[i]" view-data="rowData" /> }</div>
</section>
<section class="admin-panel p-6 phone:p-5"><h2 class="text-lg font-semibold">Images</h2><p class="mt-3 rounded-xl bg-info-surface p-4 text-sm leading-6 text-info">Image saving is not enabled until durable storage and decoded-image validation are approved. You can preview JPEG, PNG or WebP files here, but must remove selected files before saving a product without images.</p><label for="product-images" class="category-label mt-5">Select images (up to 5, 5 MB each)</label><input type="file" id="product-images" name="Images" multiple accept="image/jpeg,image/png,image/webp" class="category-input" aria-describedby="image-error" /><span asp-validation-for="Images" id="image-error" class="create-error"></span><p class="mt-2 text-sm text-text-muted">Preview only; nothing is stored. Files must be reselected after a server validation error.</p><div data-image-previews class="mt-4 grid grid-cols-2 gap-3 phone:grid-cols-1"></div><button type="button" data-clear-images class="button button-secondary mt-4" hidden>Remove selected images</button></section>
<div class="flex flex-wrap items-center gap-3"><button class="button button-primary" type="submit" data-busy-label="Saving product...">Save product</button><a class="button button-secondary" asp-action="Index">Cancel</a><span data-form-status role="status" class="text-sm text-text-muted"></span></div>
</div>
<aside class="min-w-0 space-y-6"><section class="admin-panel p-6"><h2 class="text-lg font-semibold">Visibility</h2><label class="mt-5 flex min-h-11 items-start gap-3 text-sm"><input asp-for="IsActive" class="h-5 w-5 accent-brand" />Product active</label><p class="mt-3 text-sm leading-6 text-text-muted">Availability is manual until the inventory engine is implemented. No stock balances or quantities are created here.</p><p class="mt-3 text-sm leading-6 text-text-muted">Future shopping requires an active category, active product and active/available selling option. The demonstration storefront is unchanged.</p></section>
<section class="admin-panel p-6"><h2 class="text-lg font-semibold">Choose the right stock rule</h2><p class="mt-3 text-sm leading-6 text-text-muted">A carton sold from loose-bottle stock can use the bottle option as its source. Enter the exact bottles per carton; never assume a pack size.</p><p class="mt-3 text-sm leading-6 text-text-muted">Count sealed cartons separately if they must stay sealed. A 25 kg rice bag and a 5 kg rice bag keep their own stock. Nothing is automatically unpacked or merged.</p><p class="mt-3 text-sm leading-6 text-text-muted">Prices are independent of stock quantities. These rules prepare the catalogue for inventory; they do not deduct stock today.</p></section>
@if(Model.Categories.Count==0) { <p role="alert" class="rounded-xl bg-warning-surface p-5 text-sm text-warning">An active category is required. Create or activate one in Category Management.</p> }
</aside></div></form>
<template id="variant-template">@{ var rowData=new ViewDataDictionary(ViewData);rowData.TemplateInfo.HtmlFieldPrefix="Variants[__variant__]"; }<partial name="_CreateVariant" model="@(new VariantCreateInput())" view-data="rowData" /></template>
<template id="conversion-template">@{ var conversionData=new ViewDataDictionary(ViewData);conversionData.TemplateInfo.HtmlFieldPrefix="Variants[__variant__].Conversions[__conversion__]"; }<partial name="_CreateConversion" model="@(new ConversionCreateInput())" view-data="conversionData" /></template>
<script src="~/js/product-create.js" asp-append-version="true" defer></script>

