@model ILLiasu_Local_Mall.ViewModels.Account.RegisterViewModel
@{ ViewData["Title"] = "Create your account"; ViewData["Description"] = "Register to access your customer account. No purchase is required."; }
<form asp-action="Register" method="post" class="flex flex-col gap-5">
    <input asp-for="ReturnUrl" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-sm text-error" role="alert"></div>
    <div><label asp-for="Email" class="block text-sm font-medium mb-2"></label><input asp-for="Email" autocomplete="email" type="email" required class="w-full border border-control-border rounded-control px-3 py-3 text-base bg-surface" /><span asp-validation-for="Email" class="block text-sm text-error mt-1"></span></div>
    <div><label asp-for="Password" class="block text-sm font-medium mb-2"></label><input asp-for="Password" autocomplete="new-password" required aria-describedby="password-help" class="w-full border border-control-border rounded-control px-3 py-3 text-base bg-surface" /><span asp-validation-for="Password" class="block text-sm text-error mt-1"></span><partial name="_PasswordHelp" /></div>
    <div><label asp-for="ConfirmPassword" class="block text-sm font-medium mb-2"></label><input asp-for="ConfirmPassword" autocomplete="new-password" required class="w-full border border-control-border rounded-control px-3 py-3 text-base bg-surface" /><span asp-validation-for="ConfirmPassword" class="block text-sm text-error mt-1"></span></div>
    <button type="submit" class="button button-primary w-full">Create account</button>
    <p class="text-sm text-text-muted">Already registered? <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-link font-medium underline underline-offset-4">Sign in</a></p>
</form>
