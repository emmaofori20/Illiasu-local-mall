<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ILLiasu_Local_Mall</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);node_modules/**</DefaultItemExcludes>
    <UserSecretsId>971c0add-745e-42b7-a181-d324a5db36e7</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Content Remove="tests/**" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.31" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.31">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.31" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep build tooling and local configuration out of the hosted application. -->
    <Content Update="appsettings.Development.json;package.json;package-lock.json;dotnet-tools.json" CopyToPublishDirectory="Never" />
    <!-- Bootstrap is unused; retain source vendor files but omit them from deployment. -->
    <Content Remove="wwwroot/lib/bootstrap/**" />
    <!-- These are build inputs; the compiled app.css is the public stylesheet. -->
    <Content Remove="wwwroot/css/tokens.css" />
  </ItemGroup>

  <!-- Publish validates committed production assets without requiring Node/npm. -->
  <Import Project="build/ProductionCss.targets" />

</Project>
